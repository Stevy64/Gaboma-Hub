# Copier vers .env.production. Ne jamais committer ce fichier renseigné.
# Générer deux valeurs distinctes avec secrets.token_hex(32) (mot de passe DB compatible URL).
SECRET_KEY=
POSTGRES_PASSWORD=
HUB_DOMAIN=hub.gabomazone.com
ACME_EMAIL=admin@example.com
HUB_IMAGE=gaboma-hub:local
# Activer SMTP et SingPay avec vos paramètres de production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SINGPAY_ENVIRONMENT=sandbox
SINGPAY_API_KEY=
SINGPAY_API_SECRET=
SINGPAY_MERCHANT_ID=
SINGPAY_DISBURSEMENT_ID=
SINGPAY_WEBHOOK_SECRET=
