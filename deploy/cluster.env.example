# Modèle du Secret du namespace hub.
# Sur le VPS : /etc/hub/app.env, mode 600. Ne pas commiter le fichier rempli.
# Générer la clé : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Le site public est hub.gabomazone.com.
# localhost sert aux sondes. L'Ingress n'envoie que le nom public.
# Postgres est celui du namespace donnees. L'application lit DATABASE_URL.
# Redis reste dans le namespace : cache et sessions. Pas d'Ingress.

DEBUG=false
SECRET_KEY=remplacer-par-secrets.token_urlsafe-48
ALLOWED_HOSTS=hub.gabomazone.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://hub.gabomazone.com
PUBLIC_BASE_URL=https://hub.gabomazone.com
TRUST_PROXY_HEADERS=true
SECURE_SSL_REDIRECT=true
DATABASE_URL=postgresql://hub:MOT@postgres.donnees.svc.cluster.local:5432/hub?sslmode=disable
REDIS_URL=redis://redis:6379/0

# SMTP, pour les mots de passe. Sans EMAIL_HOST, le backend console écrit dans les journaux.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Gaboma Hub <noreply@gabomazone.com>

# SingPay de production avant d'encaisser.
# Callback : https://hub.gabomazone.com/paiements/singpay/callback/
# SINGPAY_ENVIRONMENT=production
# SINGPAY_API_KEY=
# SINGPAY_API_SECRET=
# SINGPAY_MERCHANT_ID=
# SINGPAY_DISBURSEMENT_ID=
# SINGPAY_WEBHOOK_SECRET=
