{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "hub-config",
        "namespace": "gaboma-hub"
      },
      "data": {
        "DEBUG": "false",
        "ALLOWED_HOSTS": "hub.gabomazone.com,localhost,127.0.0.1",
        "CSRF_TRUSTED_ORIGINS": "https://hub.gabomazone.com",
        "PUBLIC_BASE_URL": "https://hub.gabomazone.com",
        "REDIS_URL": "redis://hub-redis:6379/0",
        "TRUST_PROXY_HEADERS": "true",
        "SECURE_SSL_REDIRECT": "true",
        "SESSION_COOKIE_SECURE": "true",
        "CSRF_COOKIE_SECURE": "true"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "hub-nginx",
        "namespace": "gaboma-hub"
      },
      "data": {
        "nginx.conf": "pid /tmp/nginx.pid;\nevents { worker_connections 512; }\nhttp {\n include /etc/nginx/mime.types;\n default_type application/octet-stream;\n access_log /dev/stdout;\n error_log /dev/stderr;\n client_body_temp_path /tmp/client;\n proxy_temp_path /tmp/proxy;\n fastcgi_temp_path /tmp/fastcgi;\n uwsgi_temp_path /tmp/uwsgi;\n scgi_temp_path /tmp/scgi;\n server {\n  listen 8080;\n  server_name hub.gabomazone.com;\n  client_max_body_size 12m;\n  location /media/ { alias /srv/media/; autoindex off; add_header X-Content-Type-Options nosniff; }\n  location / { proxy_pass http://127.0.0.1:8000; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }\n }\n}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "hub-postgres",
        "namespace": "gaboma-hub"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "hub-media",
        "namespace": "gaboma-hub"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "5Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "hub-db",
        "namespace": "gaboma-hub"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "hub-db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "hub-db"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "postgres",
                "image": "postgres:16-alpine",
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "hub"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "hub"
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "hub-secrets",
                        "key": "POSTGRES_PASSWORD"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "memory": "1Gi"
                  }
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "hub",
                      "-d",
                      "hub"
                    ]
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "hub-postgres"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "hub-db",
        "namespace": "gaboma-hub"
      },
      "spec": {
        "selector": {
          "app": "hub-db"
        },
        "ports": [
          {
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "hub-redis",
        "namespace": "gaboma-hub"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "hub-redis"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "hub-redis"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "redis",
                "image": "redis:7.4-alpine",
                "args": [
                  "redis-server",
                  "--maxmemory",
                  "128mb",
                  "--maxmemory-policy",
                  "allkeys-lru",
                  "--save",
                  "",
                  "--appendonly",
                  "no"
                ],
                "ports": [
                  {
                    "containerPort": 6379
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "redis-cli",
                      "ping"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "hub-redis",
        "namespace": "gaboma-hub"
      },
      "spec": {
        "selector": {
          "app": "hub-redis"
        },
        "ports": [
          {
            "port": 6379,
            "targetPort": 6379
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "hub-private",
        "namespace": "gaboma-hub"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {}
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "hub-gateway",
        "namespace": "gaboma-hub"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "hub-web"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ]
      }
    }
  ]
}
