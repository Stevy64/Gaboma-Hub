{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "hub-migrate",
        "namespace": "gaboma-hub"
      },
      "spec": {
        "backoffLimit": 1,
        "activeDeadlineSeconds": 300,
        "ttlSecondsAfterFinished": 86400,
        "template": {
          "metadata": {
            "labels": {
              "app": "hub-migrate"
            }
          },
          "spec": {
            "restartPolicy": "Never",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "migrate",
                "image": "gaboma-hub:replace",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "hub-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "hub-secrets"
                    }
                  }
                ],
                "command": [
                  "python",
                  "manage.py",
                  "migrate",
                  "--noinput"
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
