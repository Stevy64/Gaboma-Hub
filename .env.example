DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=sqlite:///db.sqlite3
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Même contrat d'intégration que Fallaman, sans recopier ses secrets.
SINGPAY_API_KEY=
SINGPAY_API_SECRET=
SINGPAY_MERCHANT_ID=
SINGPAY_DISBURSEMENT_ID=
SINGPAY_ENVIRONMENT=sandbox
SINGPAY_BASE_URL=https://gateway.singpay.ga
SINGPAY_LOGO_URL=
SINGPAY_WEBHOOK_SECRET=
SINGPAY_WEBHOOK_TOLERANCE_SECONDS=300
SINGPAY_WEBHOOK_REQUIRE_FRESH_TIMESTAMP=false
SINGPAY_CHECKOUT_HOSTS=gateway.singpay.ga,client.singpay.ga,pay.singpay.ga

# Pour les réinitialisations de mot de passe en local, le courriel est affiché dans le terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Gaboma Hub <noreply@localhost>
# HTTP local uniquement. Activer ces paramètres derrière un domaine HTTPS en production.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
